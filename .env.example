# 前端 API 基础地址：以 / 开头的同源路径，或完整的 HTTP(S) 地址。
# 默认使用 /api；完整地址会直接请求后端，需由后端允许跨域。
VITE_API_BASE_URL=/api

# 仅供 Vite 开发服务器使用；留空时不启用代理。
# 填写后端源地址，不带路径，例如 http://localhost:8080。
# 请求 /api/users 将转发为 http://localhost:8080/api/users，保留 /api 前缀。
API_PROXY_TARGET=

# 本地 Mock 接口，设置为 true 时启用。启用时使用同源 /api 并清空代理目标。
MOCK_AUTH_ENABLED=false
